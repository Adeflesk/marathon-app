# Copy to .env (never commit .env). Get a token from Smashrun's API Explorer.
SMASHRUN_TOKEN=
# The day you generated the token (YYYY-MM-DD). Tokens last about 60 days; the dashboard warns in the last week.
SMASHRUN_TOKEN_ISSUED=
# Garmin Personal API key (connect.garmin.com/app/settings/personalApiToken; shown once, valid 30 to 365 days).
GARMIN_API_KEY=
# The day the key runs out (YYYY-MM-DD); the dashboard warns in the last week.
GARMIN_API_KEY_EXPIRES=
